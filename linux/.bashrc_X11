# Set DISPLAY for Linux
#
# Note: this file must use unix line endings (LF)!

# skip when VS Code captures its environment (see .bash_profile); a DISPLAY found here would be
# inherited by every VS Code terminal and go stale when its SSH session closes
[ -n "${VSCODE_RESOLVING_ENVIRONMENT:-}" ] && return 0

if [ -z ${VB:+dummy} ]; then
    export VB=false
else
    if [ "${VB}" = true ]; then
	      # load bash utilities
	      fpretty=${HOME}/config/.bashrc_pretty
	      if [ -e $fpretty ]; then
	          source $fpretty
	      fi
        print_source
    fi
fi

dispOK=false
if [ -z $DISPLAY ];then
    vecho "${TAB}DISPLAY not set"
else
    vecho -n "${TAB}DISPLAY set to $DISPLAY... "
    xdpyinfo -display $DISPLAY &>/dev/null
    RETVAL=$?
    if [[ $RETVAL == 0 ]]; then
	      dispOK=true
	      vecho -e "${GOOD}OK${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
    else
	      vecho -e "${BAD}FAIL${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
	      unset DISPLAY
    fi
fi

if ! $dispOK; then
    if [ "${VB}" = true ]; then
	      echo "${TAB}building candidate DISPLAY list..."
	      itab
    fi
    # local display (the WSL2 version also tries the /etc/resolv.conf nameserver, which is the
    # Windows host there but only a DNS server here)
    display_list="localhost "
    for disp in $display_list
    do
	      export DISPLAY="${disp}:0.0"
	      vecho -n "${TAB}setting DISPLAY to $DISPLAY... "
	      timeout -s 9 1s xdpyinfo -display $DISPLAY &>/dev/null
	      RETVAL=$?
	      if [[ $RETVAL == 0 ]]; then
	          vecho -e "${GOOD}OK${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
	          break
	      else
	          vecho -e "${BAD}FAIL${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
	          unset DISPLAY
	      fi
    done

    # SSH-forwarded displays (ssh -X) of this user's sessions, newest first; sshd numbers them
    # from 10 up, one per session, and adds a cookie for each to ~/.Xauthority
    fwd_list=$(xauth list 2>/dev/null | awk -v h="$(hostname)" -F'[ :]' '$1 == h"/unix" {print $2}' | sort -rnu | tr '\n' ' ')
    if [ -z "${DISPLAY}" ]; then
	      vecho "${TAB}forwarded displays in ~/.Xauthority: ${fwd_list:-none}"
    fi
    for i in $fwd_list
    do
	      # stop once a display above was found
	      [ -n "${DISPLAY}" ] && break
	      export DISPLAY="localhost:${i}.0"
	      vecho -n "${TAB}setting DISPLAY to $DISPLAY... "
	      timeout -s 9 3s xdpyinfo -display $DISPLAY &>/dev/null
	      RETVAL=$?
	      if [[ $RETVAL == 0 ]]; then
	          vecho -e "${GOOD}OK${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
	          break
	      else
	          vecho -e "${BAD}FAIL${RESET} ${GRAY}RETVAL=$RETVAL${RESET}"
	          unset DISPLAY
	      fi
    done

    dtab

    if [ -z "${DISPLAY}" ]; then
	      vecho -e "${TAB}${BAD}ERROR: ${RESET}DISPLAY not set"
    else
	      vecho "${TAB}DISPLAY set to $DISPLAY"
    fi
fi

if [ "${VB}" = true ]; then
    # reset tab
    dtab
fi
